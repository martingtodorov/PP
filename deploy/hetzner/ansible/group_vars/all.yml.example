---
# copy to group_vars/all.yml, fill in the secrets, then: ansible-vault encrypt group_vars/all.yml

# ---------- identity / paths ----------
app_name: purepeptide
# first domain is the canonical one (used for sitemaps, emails, OG tags)
site_domains:
  - purepeptide.bg
  - purepeptide.eu
  - purepeptide.ro
  - purepeptide.gr
  - purepeptide-labs.bg
app_dir: /opt/purepeptide
web_root: /var/www/purepeptide
env_dir: /etc/purepeptide
media_dir: /var/lib/purepeptide/media      # PERSISTENT — never touched by a deploy
ssl_dir: /etc/ssl/purepeptide
repo_url: git@github.com:YOURORG/purepeptide.git
ref: main

# ---------- network / NAT ----------
ssh_port: 22
private_cidr: 10.0.0.0/16
frontend_private_ip: 10.0.0.2
backend_private_ip: 10.0.0.3
# nat_public_iface: eth0                   # autodetected when omitted
wg_port: 51820
wg_front_ip: 10.99.0.1
wg_back_ip: 10.99.0.2
wg_mtu: 1370
backend_service_user: www-data
nat_table: 100
nat_mark: "0x1"
nat_rule_priority: 1000

# ---------- backend env ----------
db_name: purepeptide
mongo_url: "mongodb://localhost:27017"
public_site_url: ""                        # empty = per-locale domains are used in emails
jwt_secret: "CHANGE_ME_64_HEX"
admin_email: "admin@purepeptide.bg"
admin_password: "CHANGE_ME"
contact_email: "info@purepeptide.bg"

# AI translations (owner's own Anthropic key)
anthropic_api_key: "sk-ant-..."
anthropic_model: "claude-sonnet-5"

# transactional email
resend_api_key: "re_..."
sender_email: "PurePeptide <no-reply@purepeptide.bg>"
admin_notify_email: "admin@purepeptide.bg"

# bank transfer details shown at checkout and in emails
bank_name: "DSK Bank"
bank_iban: "BG61STSA93000032400775"
bank_bic: "STSABGSF"
bank_holder: "Purepeptide LTD"

# courier / checkout platform (Econt, BoxNow, Pigeon, GLS, FAN, Speedex)
nextcart_base_url: "https://client.nextcartmanager.com"
nextcart_shop: "etb7zb-gy.myshopify.com"
nextcart_country: "BG"
nextcart_locale: "bg"
nextcart_currency: "EUR"

# web push for admin order alerts
vapid_public_key: "..."
vapid_private_key: "..."
vapid_subject: "mailto:admin@purepeptide.bg"

# abandoned cart recovery
abandoned_delay_min: 60
abandoned_sweep_sec: 600

# managed object storage — only needed for the one-off media export (--tags media)
emergent_llm_key: ""

# ---------- behaviour ----------
releases_kept: 5
node_major: 20
mongo_major: "7.0"
backup_dir: /var/backups/purepeptide
