; copy to inventory.ini (gitignored) — these values are PRODUCTION STATE, do not change them
;
; The SSH key is set ONCE below in [all:vars] (pp_ssh_key) — both hosts and the jump host use it.
; pp-back is reached over the WireGuard tunnel (private 10.0.0.3) through pp-front. A rebuilt
; pp-back gets a new SSH host key, which makes OpenSSH refuse the connection
; ("REMOTE HOST IDENTIFICATION HAS CHANGED"). The tunnel host therefore keeps its own throwaway
; known_hosts file — clear the old key once with:  ssh-keygen -R 10.0.0.3
[frontend]
pp-front ansible_host=2.28.79.24 ansible_user=root

[backend]
pp-back ansible_host=10.0.0.3 ansible_user=deploy ansible_ssh_common_args="-o IdentitiesOnly=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ProxyCommand='ssh -i {{ pp_ssh_key }} -o IdentitiesOnly=yes -W %h:%p root@2.28.79.24'"

[all:vars]
pp_ssh_key=~/Documents/Autobid/id_ed25519
ansible_ssh_private_key_file={{ pp_ssh_key }}
ansible_python_interpreter=/usr/bin/python3
backend_private_ip=10.0.0.3
