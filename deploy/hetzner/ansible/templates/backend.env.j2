# {{ app_name }} backend — rendered by Ansible, do not edit by hand
MONGO_URL={{ mongo_url }}
DB_NAME={{ db_name }}
MEDIA_ROOT={{ media_dir }}

CORS_ORIGINS={{ site_domains | map('regex_replace', '^(.*)$', 'https://\\1') | join(',') }}
PUBLIC_SITE_URL={{ public_site_url }}

JWT_SECRET={{ jwt_secret }}
ADMIN_EMAIL={{ admin_email }}
ADMIN_PASSWORD={{ admin_password }}
# leave 0: a restart must never reset a password changed in the admin panel
ADMIN_PASSWORD_RESET={{ 1 if admin_password_reset | default(false) | bool else 0 }}
CONTACT_EMAIL={{ contact_email }}

BANK_NAME={{ bank_name }}
BANK_IBAN={{ bank_iban }}
BANK_BIC={{ bank_bic }}
BANK_HOLDER={{ bank_holder }}

RESEND_API_KEY={{ resend_api_key }}
SENDER_EMAIL={{ sender_email }}
ADMIN_NOTIFY_EMAIL={{ admin_notify_email }}

ANTHROPIC_API_KEY={{ anthropic_api_key }}
ANTHROPIC_MODEL={{ anthropic_model }}

NEXTCART_BASE_URL={{ nextcart_base_url }}
NEXTCART_SHOP={{ nextcart_shop }}
NEXTCART_COUNTRY={{ nextcart_country }}
NEXTCART_LOCALE={{ nextcart_locale }}
NEXTCART_CURRENCY={{ nextcart_currency }}
NEXTCART_SNAPSHOT_ONLY={{ 'true' if nextcart_snapshot_only | default(true) | bool else 'false' }}

VAPID_PUBLIC_KEY={{ vapid_public_key }}
VAPID_PRIVATE_KEY={{ vapid_private_key }}
VAPID_SUBJECT={{ vapid_subject }}

ABANDONED_DELAY_MIN={{ abandoned_delay_min }}
ABANDONED_SWEEP_SEC={{ abandoned_sweep_sec }}

EMERGENT_LLM_KEY={{ emergent_llm_key }}
