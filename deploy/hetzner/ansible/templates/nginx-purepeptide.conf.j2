# {{ app_name }} — rendered by Ansible
map $sent_http_content_type $pp_immutable {
    default                    "";
    ~image/                    "public, max-age=31536000, immutable";
    ~font/                     "public, max-age=31536000, immutable";
}

# ---------- one canonical URL per page ----------
# purepeptide.eu serves no language of its own: every page lives under a prefix (/en, /cz, …).
# Without these redirects the same page answered 200 on three URLs (/, /en/, /products/x) with a
# canonical pointing elsewhere — duplicate, crawlable URLs. Now the prefixed one is the only one.
map $host $pp_shared_host {
    default                             0;
    "~*^(www\.)?purepeptide\.eu$"       1;
}

# 1 = the URI already carries a locale prefix or must never be redirected (API, assets, admin)
map $uri $pp_reserved {
    default                                                          0;
    "~^/(en|fr|de|cz|hu|pl|sk|si)(/|$)"                              1;
    "~^/(api|wp-json|static|admin)(/|$)"                             1;
    "~^/(robots\.txt|sitemap\.xml|llms\.txt|agents\.md|index\.html|service-worker\.js|manifest\.json|favicon\.ico|asset-manifest\.json)$" 1;
    "~*\.[a-z0-9]{2,5}$"                                             1;
}

map "$pp_shared_host:$pp_reserved" $pp_needs_en {
    default   0;
    "1:0"     1;
}

server {
    listen 80;
    listen [::]:80;
    server_name {{ site_domains | join(' ') }};
    return 301 https://$host$request_uri;
}

{#
  Each Cloudflare zone (purepeptide.bg / .eu / .ro / .gr / purepeptide-labs.bg) needs its OWN
  Origin certificate — one cert cannot cover hostnames from another zone. `site_tls_certs` maps a
  domain to its cert/key; anything missing falls back to the shared ssl_cert_path/ssl_key_path, so
  the current single-certificate production setup renders exactly as before. Domains sharing the
  same pair are grouped into one server block and nginx picks the right one via SNI.
#}
{%- set tls = site_tls_certs | default({}, true) -%}
{%- set groups = {} -%}
{%- for d in site_domains -%}
{%-   set entry = tls.get(d) | default({}, true) -%}
{%-   set pair = (entry.get('cert') | default(ssl_cert_path, true)) ~ '|' ~ (entry.get('key') | default(ssl_key_path, true)) -%}
{%-   if groups.update({pair: (groups.get(pair, []) + [d])}) %}{% endif -%}
{%- endfor -%}
{%- macro site_body() -%}
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    root {{ web_root }}/build;
    index index.html;
    client_max_body_size 16m;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 512;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml;

    # ---------- API ----------
    # ^~ is mandatory: nginx evaluates regex locations BEFORE prefix ones, so without it every
    # /api/files/*.png|jpg|webp request is captured by the static image regex below and answered with
    # nginx's own 404 (this is what broke every product image after the Matrixify import).
    location ^~ /api/ {
        proxy_pass http://{{ backend_private_ip }}:8001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Origin https://$host;
        proxy_set_header Connection "";
        # progress polling for the AI translation jobs must not be buffered
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # WooCommerce-compatible REST façade for the NextLevel fulfillment warehouse (backend/wc_api.py)
    location ^~ /wp-json/ {
        proxy_pass http://{{ backend_private_ip }}:8001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
        proxy_pass_header Authorization;
        proxy_set_header Connection "";
    }

    # media is content-addressed and served as WebP/JPEG by the backend
    location ^~ /api/files/ {
        proxy_pass http://{{ backend_private_ip }}:8001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Accept $http_accept;
        proxy_cache_key "$scheme$host$request_uri$http_accept";
        # never `always`: a long Cache-Control on a 404 poisons Cloudflare and the browser cache
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Vary "Accept";
    }

    # ---------- static build ----------
    location /static/ {
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /service-worker.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files $uri =404;
    }

    location ~* \.(png|jpe?g|webp|svg|gif|ico|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        try_files $uri =404;
    }

    location = /robots.txt   { try_files $uri @backend; }

    # the sitemap is generated per locale by the backend — /sitemap.xml is what crawlers ask for
    location = /sitemap.xml {
        proxy_pass http://{{ backend_private_ip }}:8001/api/sitemap.xml;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    # llms.txt / agents.md must be served as Markdown, never as the SPA shell
    location = /llms.txt {
        # always fresh: generated from the database (handles change when a URL is rotated)
        proxy_pass http://127.0.0.1:8001/api/llms.txt;
        proxy_set_header Host $host;
    }
    location = /agents.md {
        default_type text/markdown;
        charset utf-8;
        try_files $uri =404;
    }

    location @backend {
        proxy_pass http://{{ backend_private_ip }}:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    # the shell the prerenderer starts from — must be served straight off disk, never proxied
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # ---------- server-side prerender ----------
    # A React shell gives crawlers no title, canonical, H1 or product data. Page requests go to the
    # backend, which returns finished HTML (head tags, JSON-LD, content) — and keeps the real status,
    # so a missing product answers 404 instead of a soft 200. Only a broken backend falls back to
    # the static shell.
    location @prerender {
        proxy_pass http://{{ backend_private_ip }}:8001/api/seo/prerender?path=$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 10s;
        proxy_intercept_errors on;
        error_page 500 502 503 504 = @spa;
    }

    location @spa {
        add_header Cache-Control "no-cache" always;
        try_files /index.html =404;
    }

    # /pages/homepage existed only in the old Shopify theme; the HTML sitemap pages still exist
    # here, so they are served (and prerendered), not redirected
    location ~ ^(/(?:en|fr|de|cz|hu|pl|sk|si))?/pages/homepage$ {
        set $pp_prefix $1;              # `set` before `if`, which would drop the capture
        if ($pp_needs_en) {
            set $pp_prefix /en;
        }
        return 301 https://$host$pp_prefix/;
    }

    # a locale root must end in a slash — /cz answered 200 with a canonical of /cz/
    location ~ ^/(en|fr|de|cz|hu|pl|sk|si)$ {
        return 301 https://$host/$1/;
    }

    # the home page: without this nginx would serve index.html straight from disk (index directive)
    # and the prerender would never run for "/"
    location = / {
        if ($pp_shared_host) {
            return 301 https://$host/en/;
        }
        try_files /prerender-the-home-page @prerender;
    }

    # SPA fallback — locale prefixes (/en, /fr, …) are handled by the app
    location / {
        # on purepeptide.eu an unprefixed page is a duplicate of the English one
        if ($pp_needs_en) {
            return 301 https://$host/en$request_uri;
        }
        try_files $uri @prerender;
        add_header Cache-Control "no-cache" always;
    }
{%- endmacro -%}
{% for pair, domains in groups.items() %}

server {
{% if nginx_http2_directive == 'listen' %}
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
{% else %}
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
{% endif %}
    server_name {{ domains | join(' ') }};

    ssl_certificate     {{ pair.split('|')[0] }};
    ssl_certificate_key {{ pair.split('|')[1] }};
{{ site_body() }}
}
{%- endfor -%}

# Internal shell endpoint: the backend fetches the built index.html from here to prerender pages.
# Port 80 redirects to https and https goes through Cloudflare, so neither can serve this.
server {
    listen {{ frontend_private_ip }}:8080;
    server_name _;
    root {{ web_root }}/build;
    access_log off;

    location = /index.html {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }
    location / { return 404; }
}
