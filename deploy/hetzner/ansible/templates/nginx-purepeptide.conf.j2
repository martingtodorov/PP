# {{ app_name }} — rendered by Ansible
map $sent_http_content_type $pp_immutable {
    default                    "";
    ~image/                    "public, max-age=31536000, immutable";
    ~font/                     "public, max-age=31536000, immutable";
}

# ---------- one canonical URL per page ----------
# purepeptide.eu serves no language of its own: every page lives under a prefix (/en, /cz, …).
# Without these redirects the same page answered 200 on three URLs (/, /en/, /products/x) with a
# canonical pointing elsewhere — duplicate, crawlable URLs. Now the prefixed one is the only one.
map $host $pp_shared_host {
    default                             0;
    "~*^(www\.)?purepeptide\.eu$"       1;
}

# /index.html is an obsolete public alias. Go directly to the canonical homepage, including EU.
map $pp_shared_host $pp_home_path {
    default /;
    1       /en/;
}

# 1 = the URI already carries a locale prefix or must never be redirected (API, assets, admin)
map $uri $pp_reserved {
    default                                                          0;
    "~^/(en|fr|de|cz|hu|pl|sk|si)(/|$)"                              1;
    "~^/(api|wp-json|static|admin)(/|$)"                             1;
    "~^/(robots\.txt|sitemap\.xml|llms\.txt|agents\.md|index\.html|service-worker\.js|manifest\.json|favicon\.ico|asset-manifest\.json)$" 1;
    "~*\.[a-z0-9]{2,5}$"                                             1;
}

map "$pp_shared_host:$pp_reserved" $pp_needs_en {
    default   0;
    "1:0"     1;
}

# www.* is a separate hostname for Google — it must 301 to the apex, never serve a second copy
map $host $pp_apex {
    default                 $host;
    "~*^www\.(?<apex>.+)$"  $apex;
}

# ---------- countries we do not serve ----------
# Empty by default (owner's call 20.06.2026: the US/CA block is off again). Cloudflare hands the
# country over in CF-IPCountry, so the decision can be made here at the origin — list the codes in
# `blocked_countries` (group_vars/all.yml) to switch it back on for a country.
map $http_cf_ipcountry $pp_geo_blocked {
    default   0;
{% for c in blocked_countries | default([]) %}    {{ c }}        1;
{% endfor %}}

# Googlebot, Bingbot and the AI crawlers all crawl from US addresses: blocking them would end the
# indexing (and Search Console would stop reading the sitemaps). Verified-bot data is a paid
# Cloudflare feature, so the origin matches the crawler user agents instead — the worst a forged
# one gets is to see a public shop page.
map $http_user_agent $pp_crawler {
    default                                                          0;
    "~*(googlebot|google-inspectiontool|storebot-google|bingbot|adidxbot|duckduckbot|applebot|yandex(bot|images)|baiduspider|slurp|petalbot|ahrefsbot|semrushbot)" 1;
    "~*(gptbot|oai-searchbot|chatgpt-user|perplexitybot|perplexity-user|claudebot|claude-user|anthropic-ai|amazonbot|meta-externalagent|bytespider|google-extended)" 1;
    "~*(facebookexternalhit|twitterbot|linkedinbot|whatsapp|telegrambot|slackbot|discordbot|pinterest)" 1;
    "~*(uptimerobot|pingdom|better ?uptime|statuscake|cf-uam)"        1;
}

map "$pp_geo_blocked:$pp_crawler" $pp_block {
    default   0;
    "1:0"     1;
}

server {
    listen 80;
    listen [::]:80;
    server_name {{ site_domains | join(' ') }} www.{{ site_domains | join(' www.') }};
    location = /index.html { return 301 https://$pp_apex$pp_home_path$is_args$args; }
    location / { return 301 https://$pp_apex$request_uri; }
}

{#
  Each Cloudflare zone (purepeptide.bg / .eu / .ro / .gr / purepeptide-labs.bg) needs its OWN
  Origin certificate — one cert cannot cover hostnames from another zone. `site_tls_certs` maps a
  domain to its cert/key; anything missing falls back to the shared ssl_cert_path/ssl_key_path, so
  the current single-certificate production setup renders exactly as before. Domains sharing the
  same pair are grouped into one server block and nginx picks the right one via SNI.
#}
{%- set tls = site_tls_certs | default({}, true) -%}
{%- set groups = {} -%}
{%- for d in site_domains -%}
{%-   set entry = tls.get(d) | default({}, true) -%}
{%-   set pair = (entry.get('cert') | default(ssl_cert_path, true)) ~ '|' ~ (entry.get('key') | default(ssl_key_path, true)) -%}
{%-   if groups.update({pair: (groups.get(pair, []) + [d])}) %}{% endif -%}
{%- endfor -%}
{%- macro site_body() -%}
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    root {{ web_root }}/build;
    index index.html;
    client_max_body_size 16m;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # A visitor from a country we do not serve gets an unconfigured-domain page, nothing more.
    # The `if` has to sit inside the content locations below: with `return 403` in the server block
    # nginx answers with its own default 403 body and ignores `error_page`.
    error_page 403 /_not-live.html;
    location = /_not-live.html {
        internal;
        alias {{ web_root }}/error-pages/_not-live.html;
        add_header Cache-Control "no-store" always;
    }

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 512;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml;

    # ---------- API ----------
    # ^~ is mandatory: nginx evaluates regex locations BEFORE prefix ones, so without it every
    # /api/files/*.png|jpg|webp request is captured by the static image regex below and answered with
    # nginx's own 404 (this is what broke every product image after the Matrixify import).
    location ^~ /api/ {
        if ($pp_block) { return 403; }
        proxy_pass http://{{ backend_private_ip }}:8001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Origin https://$host;
        proxy_set_header Connection "";
        # progress polling for the AI translation jobs must not be buffered
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # WooCommerce-compatible REST façade for the NextLevel fulfillment warehouse (backend/wc_api.py)
    # not guarded by $pp_block: this is NextLevel's integration endpoint, not a visitor
    location ^~ /wp-json/ {
        proxy_pass http://{{ backend_private_ip }}:8001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
        proxy_pass_header Authorization;
        proxy_set_header Connection "";
    }

    # media is content-addressed and served as WebP/JPEG by the backend
    location ^~ /api/files/ {
        if ($pp_block) { return 403; }
        proxy_pass http://{{ backend_private_ip }}:8001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Accept $http_accept;
        proxy_cache_key "$scheme$host$request_uri$http_accept";
        # never `always`: a long Cache-Control on a 404 poisons Cloudflare and the browser cache
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Vary "Accept";
    }

    # ---------- static build ----------
    location /static/ {
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /service-worker.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files $uri =404;
    }

    location ~* \.(png|jpe?g|webp|svg|gif|ico|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        try_files $uri =404;
    }

    # robots.txt comes from the backend, never from the build: the static file in the bundle
    # advertised all four domains' /api/sitemap.xml, so Search Console reported a cross-host
    # sitemap it "couldn't read" on every domain
    location = /robots.txt {
        proxy_pass http://{{ backend_private_ip }}:8001/api/robots.txt;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    # every sitemap file comes from the backend (index + per-kind children, like Shopify:
    # /sitemap.xml -> /sitemap_products_1.xml, _collections_, _pages_, _blogs_, _agentic_discovery)
    location ~ ^/sitemap[a-z0-9_]*\.xml$ {
        proxy_pass http://{{ backend_private_ip }}:8001/api$uri;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    # llms.txt / agents.md must be served as Markdown, never as the SPA shell
    location = /llms.txt {
        # always fresh: generated from the database (handles change when a URL is rotated)
        proxy_pass http://{{ backend_private_ip }}:8001/api/llms.txt;
        proxy_set_header Host $host;
    }
    location = /agents.md {
        default_type text/markdown;
        charset utf-8;
        try_files $uri =404;
    }

    location @backend {
        proxy_pass http://{{ backend_private_ip }}:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Only the private listener below serves the raw shell. Public copies must not be indexed.
    location = /index.html {
        return 301 https://$pp_apex$pp_home_path$is_args$args;
    }

    # ---------- server-side prerender ----------
    # A React shell gives crawlers no title, canonical, H1 or product data. Page requests go to the
    # backend, which returns finished HTML (head tags, JSON-LD, content) — and keeps the real status,
    # so a missing product answers 404 instead of a soft 200. Only a broken backend falls back to
    # the static shell.
    location @prerender {
        proxy_pass http://{{ backend_private_ip }}:8001/api/seo/prerender?path=$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 10s;
        proxy_intercept_errors on;
        error_page 500 502 503 504 = @spa;
    }

    location @spa {
        add_header Cache-Control "no-cache" always;
        try_files /index.html =404;
    }

    # /pages/homepage existed only in the old Shopify theme; the HTML sitemap pages still exist
    # here, so they are served (and prerendered), not redirected
    location ~ ^(/(?:en|fr|de|cz|hu|pl|sk|si))?/pages/homepage$ {
        set $pp_prefix $1;              # `set` before `if`, which would drop the capture
        if ($pp_needs_en) {
            set $pp_prefix /en;
        }
        return 301 https://$host$pp_prefix/;
    }

    # a locale root must end in a slash — /cz answered 200 with a canonical of /cz/
    location ~ ^/(en|fr|de|cz|hu|pl|sk|si)$ {
        return 301 https://$host/$1/;
    }

    # the home page: without this nginx would serve index.html straight from disk (index directive)
    # and the prerender would never run for "/"
    location = / {
        if ($pp_block) { return 403; }
        # the "#geo" marker (quoted — a bare # would start an nginx comment) tells the app that the
        # visitor landed here from the bare apex, so the IP check may move him to his own language.
        # Typing /en/ himself carries no marker and is never redirected. Crawlers drop fragments.
        if ($pp_shared_host) {
            return 301 "https://$host/en/$is_args$args#geo";
        }
        try_files /prerender-the-home-page @prerender;
    }

    # SPA fallback — locale prefixes (/en, /fr, …) are handled by the app
    location / {
        # nothing is served to a country we do not ship to: the visitor sees the "domain is not
        # configured" page, the same as a domain that points here without a site behind it
        if ($pp_block) { return 403; }
        # on purepeptide.eu an unprefixed page is a duplicate of the English one
        if ($pp_needs_en) {
            return 301 https://$host/en$request_uri;
        }
        try_files $uri @prerender;
        add_header Cache-Control "no-cache" always;
    }
{%- endmacro -%}
{% for pair, domains in groups.items() %}

server {
{% if nginx_http2_directive == 'listen' %}
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
{% else %}
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
{% endif %}
    server_name {{ domains | join(' ') }};

    ssl_certificate     {{ pair.split('|')[0] }};
    ssl_certificate_key {{ pair.split('|')[1] }};
{{ site_body() }}
}

# www over TLS: same certificate (the Origin cert covers *.zone), redirect only — no second copy
server {
{% if nginx_http2_directive == 'listen' %}
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
{% else %}
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
{% endif %}
    server_name www.{{ domains | join(' www.') }};

    ssl_certificate     {{ pair.split('|')[0] }};
    ssl_certificate_key {{ pair.split('|')[1] }};
    ssl_protocols TLSv1.2 TLSv1.3;

    location = /index.html { return 301 https://$pp_apex$pp_home_path$is_args$args; }

    # www root: same "#geo" marker as the apex, so the IP check still runs for a bare www visit
    location = / {
        if ($pp_needs_en) {
            return 301 "https://$pp_apex/en/$is_args$args#geo";
        }
        return 301 https://$pp_apex/$is_args$args;
    }

    # single hop: on the shared domain the final URL already carries the /en prefix
    location / {
        if ($pp_needs_en) {
            return 301 https://$pp_apex/en$request_uri;
        }
        return 301 https://$pp_apex$request_uri;
    }
}
{%- endfor -%}

# Internal shell endpoint: the backend fetches the built index.html from here to prerender pages.
# Port 80 redirects to https and https goes through Cloudflare, so neither can serve this.
server {
    listen {{ frontend_private_ip }}:8080;
    server_name _;
    root {{ web_root }}/build;
    access_log off;

    location = /index.html {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }
    location / { return 404; }
}
